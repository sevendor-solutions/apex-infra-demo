# ════════════════════════════════════════════════
#  Apex Infra — Docker Environment Variables
#  Copy this to .env and fill in your values
# ════════════════════════════════════════════════

# ── Your Domain ──────────────────────────────────
# Change yourdomain.com to your actual domain
VITE_API_URL=https://api.yourdomain.com
APP_URL=https://api.yourdomain.com

# ── Laravel App Key (keep the existing one) ──────
APP_KEY=base64:FjcIkxYrKUDxjoeTVTk4+pvAa4MvVOFBlHA4b9lK/FY=

# ── Port Mapping (Dokploy manages these) ─────────
FRONTEND_PORT=3001
BACKEND_PORT=3002

# ── Database (SQLite by default — no setup needed) ──
DB_CONNECTION=sqlite

# ── OR MySQL (uncomment if you want MySQL) ──────
# DB_CONNECTION=mysql
# MYSQL_DATABASE=apexdb
# MYSQL_USER=apexuser
# MYSQL_PASSWORD=StrongPassword123
# MYSQL_ROOT_PASSWORD=RootPassword123

# ── Mail ─────────────────────────────────────────
MAIL_HOST=smtpout.secureserver.net
MAIL_PORT=587
MAIL_USERNAME=info@apexinfra.com
MAIL_PASSWORD=your_mail_password_here
MAIL_FROM_ADDRESS=info@apexinfra.com
